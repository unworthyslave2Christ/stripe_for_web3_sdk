{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": ["ES2022"],

    "strict": true,

    "declaration": true,
    "declarationMap": true,

    "sourceMap": true,

    "outDir": "./dist",

    "rootDir": "./src",

    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,

    "noEmit": true
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "dist",
    "node_modules",
    "examples"
  ]
}